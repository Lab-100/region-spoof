__pycache__/
logs/
*.zip
bin/wintun/
*.spec
build/*/
dist/
out/
*.log

# Сторонние бинарники (sing-box, mihomo, wintun) в git не хранятся:
# скачиваются из GitHub Releases скриптом download_binaries.py
# (проверка SHA256 обязательна). Плейсхолдер каталога разрешён.
bin/
!bin/.gitkeep

